# Copy to `.env` and fill in from your Supabase project (Settings -> API).
# `.env` is gitignored — credentials never belong in the repo.
#
# The API runs fine with none of these set: it falls back to the in-memory seed,
# which is what the test suite uses. Set them to serve heroes from Postgres.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The `anon` public key. This is what the running API uses. It is safe to expose
# in the sense that row-level security decides what it can reach — the schema
# grants it SELECT and nothing else.
SUPABASE_ANON_KEY=

# The `service_role` key. Bypasses row-level security entirely, so it is only
# used by `npm run migrate` and must never reach a client or a browser.
SUPABASE_SERVICE_ROLE_KEY=
