# Copy to `.env` and fill in from your Supabase project (Settings -> API Keys).
# `.env` is gitignored — credentials never belong in the repo.
#
# The API runs fine with none of these set: it falls back to the in-memory seed,
# which is what the test suite uses. Set them to serve heroes from Postgres.
# `GET /health` reports which store actually answered.

# Project URL. It is your project ref with .supabase.co on the end, and the ref
# is in the dashboard's own address bar:
#   https://supabase.com/dashboard/project/<ref>  ->  https://<ref>.supabase.co
SUPABASE_URL=

# The publishable key (`sb_publishable_...`). This is what the running API uses.
# Safe to expose in the sense that row-level security decides what it can reach —
# the schema grants it SELECT and nothing else.
SUPABASE_PUBLISHABLE_KEY=

# The secret key (`sb_secret_...`). Bypasses row-level security entirely, so it
# is only used by `npm run migrate` and must never reach a client, a browser, or
# a deployed environment.
SUPABASE_SECRET_KEY=

# Supabase renamed these keys; the old names still work if that is what your
# dashboard shows. SUPABASE_ANON_KEY is the old name for the publishable key,
# and SUPABASE_SERVICE_ROLE_KEY is the old name for the secret key.
